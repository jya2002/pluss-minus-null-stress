# Project root only, e.g. https://YOUR_PROJECT_REF.supabase.co (no /rest/v1).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_BASE_PATH=/
# Optional local development only; ignored in production builds.
VITE_ENABLE_DEV_PASSWORD_LOGIN=false
# Google OAuth Client ID and Client Secret are configured only in Supabase
# Authentication > Providers > Google. No Google credential is needed here.
# Only in Supabase Edge Function secrets, NEVER prefix these with VITE_:
# RESEND_API_KEY=
# EMAIL_FROM=
# APP_URL=https://jya2002.github.io/pluss-minus-null-stress/
# NOTIFICATION_WORKER_SECRET=
# ALLOWED_ORIGIN=https://jya2002.github.io
# Auth SMTP credentials belong only in Supabase Dashboard > Authentication > SMTP.
# Never add SMTP passwords or Google app passwords to VITE_ variables or Git.
